[Unit]
Description=Jenkins Monitor
Wants=network-online.target
After=network-online.target

[Service]
User=jenkins-monitor
Group=jenkins-monitor
WorkingDirectory=/etc/jenkins-monitor
ExecStart=/usr/local/bin/jenkins-monitor --config /etc/jenkins-monitor/config.toml
# Optional: put JENKINS_MONITOR_JENKINS_PASSWORD=... and
# JENKINS_MONITOR_SMTP_PASSWORD=... here (chmod 600) to keep secrets out of
# config.toml.
EnvironmentFile=-/etc/jenkins-monitor/env
Restart=on-failure
RestartSec=30

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
